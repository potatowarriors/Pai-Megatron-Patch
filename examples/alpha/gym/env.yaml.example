# <Gym 클론 루트>/env.yaml 로 복사해서 채운다 (gitignored). CLI 에서는 `++policy_base_url=...` 형태로 덮어쓸 수 있다.
# 정책 = alpha fleet (eval_sft/serve_alpha.sh, TOOLS=1 REASONING_PARSER=nemotron_v3). lb_proxy 를 쓰면 :8100.
policy_base_url: http://sub1:8100/v1
policy_api_key: dummy
policy_model_name: alpha

# τ² 사용자 시뮬레이터 (configs/tau2_alpha.yaml). 키는 examples/alpha/.env 의 GEMINI_API_KEY.
user_sim_api_key: <GEMINI_API_KEY>
user_sim_model_name: gemini-2.5-flash
