# MinIO Configuration for Alpha Checkpoint Backup
# ================================================
# Copy this file to .env and fill in your MinIO credentials
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual credentials
#   chmod 600 .env  # Protect credentials

# Required: MinIO server endpoint
# Example: http://minio.example.com:9000 or https://s3.example.com
MINIO_ENDPOINT="http://your-minio-server:9000"

# Required: MinIO access credentials
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"

# Optional: Use HTTPS (default: false)
# Set to "true" if your MinIO server uses HTTPS
MINIO_SECURE="false"

# Optional: Region (default: us-east-1)
# Usually not needed for MinIO, but required for some S3-compatible services
MINIO_REGION="us-east-1"
