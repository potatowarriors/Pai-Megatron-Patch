+_SUFFIX_MULT = {'K': 10**3, 'M': 10**6, 'B': 10**9, 'T': 10**12}
+
+
+def _parse_int_with_suffix(s: str) -> int:
+    """Parse integer with optional K/M/B/T suffix (e.g. '250B' -> 250_000_000_000)."""
+    s = s.strip()
+    if not s:
+        raise ValueError("empty integer literal")
+    if s[-1].upper() in _SUFFIX_MULT:
+        return int(float(s[:-1]) * _SUFFIX_MULT[s[-1].upper()])
+    return int(s)
+
+
+def parse_step_batch_size_schedule(
+    schedule_str: str, seq_length: Optional[int] = None
+) -> List[Tuple[int, int]]:
+    """Parse step batch size schedule string into sorted list of (sample_threshold, gbs).
+
+    Format: ``"T1:BS1 T2:BS2 ..."`` where Tn supports K/M/B/T suffixes.
+    If ``seq_length`` is provided, thresholds are interpreted as **tokens** and
+    converted to samples (floor). Otherwise interpreted as samples directly.
+
+    The first entry's threshold MUST be 0.
+    """
+    pairs: List[Tuple[int, int]] = []
+    for entry in schedule_str.split():
+        if ':' not in entry:
+            raise ValueError(
+                f"invalid step-batch-size-schedule entry '{entry}', expected 'THRESHOLD:BS'"
+            )
+        thr_str, bs_str = entry.split(':', 1)
+        thr = _parse_int_with_suffix(thr_str)
+        bs = _parse_int_with_suffix(bs_str)
+        if seq_length is not None:
+            thr = thr // int(seq_length)
+        if bs <= 0:
+            raise ValueError(f"batch size must be positive, got {bs} in entry '{entry}'")
+        if thr < 0:
+            raise ValueError(f"threshold must be non-negative, got {thr} in entry '{entry}'")
+        pairs.append((thr, bs))
+    if not pairs:
+        raise ValueError("empty step-batch-size-schedule")
+    pairs.sort(key=lambda p: p[0])
+    if pairs[0][0] != 0:
+        raise ValueError(
+            f"first threshold in step-batch-size-schedule must be 0, got {pairs[0][0]}"
+        )
+    return pairs
+
