+def test_muon_optimizer_qgkv_4way_split():
+    """Test 4-way QGKV split (gated attention: Q, Gate, K, V) via per-param shapes.
+
+    Validates the patch that lets each param carry its own qkv_split_shapes,
+    so gated-attention models (linear_qgkv) get [Q, Gate, K, V] split rather
+    than the standard 3-way [Q, K, V] split or no split at all.
+    """
+    # Layout: per query-group, packed [Q | Gate | K | V] with Q == Gate, K == V.
+    ng = 2  # num_query_groups
+    qp_per_group = 64
+    kvp_per_group = 32
+    per_group = 2 * (qp_per_group + kvp_per_group)  # = 192
+    qgkv_size = ng * per_group  # = 384
+    hidden_size = 256
+
+    qgkv_split_shapes = (qp_per_group, qp_per_group, kvp_per_group, kvp_per_group)
+
+    model = torch.nn.Linear(
+        hidden_size, qgkv_size, bias=False, dtype=torch.float32, device='cuda'
+    )
+    model.requires_grad_(True)
+    model.weight.data.fill_(1.0)
+
+    # Per-param marking — mirrors what get_megatron_muon_optimizer does for linear_qgkv.
+    model.weight.is_qkv = True
+    model.weight.qkv_split_shapes = qgkv_split_shapes
+
+    # Run with 4-way split via per-param shapes (constructor-level shapes deliberately
+    # set to a wrong 3-way shape to prove per-param override wins).
+    optimizer_4way = TensorParallelMuon(
+        params=[model.weight],
+        lr=0.01,
+        split_qkv=True,
+        is_qkv_fn=lambda p: getattr(p, 'is_qkv', False),
+        qkv_split_shapes=(qp_per_group, kvp_per_group, kvp_per_group),  # ignored
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    input_tensor = torch.randn(16, hidden_size, dtype=torch.float32, device='cuda')
+    loss = model(input_tensor).sum()
+    loss.backward()
+
+    original_weight = model.weight.data.clone()
+    optimizer_4way.step()
+    weight_4way = model.weight.data.clone()
+
+    assert not torch.equal(
+        weight_4way, original_weight
+    ), "QGKV weight should be updated with 4-way split"
+
+    # Compare against no-split (whole [Q|Gate|K|V] block treated as one matrix).
+    model.weight.data.fill_(1.0)
+    if hasattr(model.weight, 'qkv_split_shapes'):
+        delattr(model.weight, 'qkv_split_shapes')
+    optimizer_no_split = TensorParallelMuon(
+        params=[model.weight],
+        lr=0.01,
+        split_qkv=False,
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    loss = model(input_tensor).sum()
+    loss.backward()
+    optimizer_no_split.step()
+    weight_no_split = model.weight.data.clone()
+
+    assert not torch.equal(
+        weight_4way, weight_no_split
+    ), "4-way split must produce a different update than no-split — proves the split path ran"
+
