index c29c48d4c..a02cb0ea9 100644
--- a/megatron/training/training.py
+++ b/megatron/training/training.py
@@ -932,9 +932,32 @@ def update_train_iters(args):
         return
 
     # Constant batch size with sample-based training.
-    if args.rampup_batch_size is None:
+    if args.rampup_batch_size is None and getattr(args, 'step_batch_size_schedule_parsed', None) is None:
         args.train_iters = args.train_samples // args.global_batch_size
 
+    elif getattr(args, 'step_batch_size_schedule_parsed', None) is not None:
+        # Sample-based training with step-wise GBS schedule.
+        # Walk the schedule; in each segment, GBS is constant so iterations are
+        # (segment_samples // gbs_in_segment), exactly. The final segment runs from
+        # the last threshold to args.train_samples.
+        schedule = args.step_batch_size_schedule_parsed  # sorted (sample_thr, gbs)
+        iterations = 0
+        consumed_samples = 0
+        for i, (thr, gbs) in enumerate(schedule):
+            if consumed_samples >= args.train_samples:
+                break
+            seg_end = (
+                schedule[i + 1][0] if (i + 1) < len(schedule) else args.train_samples
+            )
+            seg_end = min(seg_end, args.train_samples)
+            seg_samples = max(0, seg_end - consumed_samples)
+            seg_iters = seg_samples // gbs  # drop partial last batch
+            iterations += seg_iters
+            consumed_samples += seg_iters * gbs
+        # Reset calculator state to step 0 (caller will re-initialize during training).
+        update_num_microbatches(0, consistency_check=False)
+        args.train_iters = iterations
+
     else:
         # Sample based training with rampup batch size.
         iterations = 0
