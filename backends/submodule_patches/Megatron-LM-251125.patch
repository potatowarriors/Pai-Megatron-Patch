+def test_muon_optimizer_qgkv_4way_split():
+    """Test 4-way QGKV split (gated attention: Q, Gate, K, V) via per-param shapes.
+
+    Validates the patch that lets each param carry its own qkv_split_shapes,
+    so gated-attention models (linear_qgkv) get [Q, Gate, K, V] split rather
+    than the standard 3-way [Q, K, V] split or no split at all.
+    """
+    # Layout: per query-group, packed [Q | Gate | K | V] with Q == Gate, K == V.
+    ng = 2  # num_query_groups
+    qp_per_group = 64
+    kvp_per_group = 32
+    per_group = 2 * (qp_per_group + kvp_per_group)  # = 192
+    qgkv_size = ng * per_group  # = 384
+    hidden_size = 256
+
+    qgkv_split_shapes = (qp_per_group, qp_per_group, kvp_per_group, kvp_per_group)
+
+    model = torch.nn.Linear(
+        hidden_size, qgkv_size, bias=False, dtype=torch.float32, device='cuda'
+    )
+    model.requires_grad_(True)
+    model.weight.data.fill_(1.0)
+
+    # Per-param marking — mirrors what get_megatron_muon_optimizer does for linear_qgkv.
+    model.weight.is_qkv = True
+    model.weight.qkv_split_shapes = qgkv_split_shapes
+
+    # Run with 4-way split via per-param shapes (constructor-level shapes deliberately
+    # set to a wrong 3-way shape to prove per-param override wins).
+    optimizer_4way = TensorParallelMuon(
+        params=[model.weight],
+        lr=0.01,
+        split_qkv=True,
+        is_qkv_fn=lambda p: getattr(p, 'is_qkv', False),
+        qkv_split_shapes=(qp_per_group, kvp_per_group, kvp_per_group),  # ignored
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    input_tensor = torch.randn(16, hidden_size, dtype=torch.float32, device='cuda')
+    loss = model(input_tensor).sum()
+    loss.backward()
+
+    original_weight = model.weight.data.clone()
+    optimizer_4way.step()
+    weight_4way = model.weight.data.clone()
+
+    assert not torch.equal(
+        weight_4way, original_weight
+    ), "QGKV weight should be updated with 4-way split"
+
+    # Compare against no-split (whole [Q|Gate|K|V] block treated as one matrix).
+    model.weight.data.fill_(1.0)
+    if hasattr(model.weight, 'qkv_split_shapes'):
+        delattr(model.weight, 'qkv_split_shapes')
+    optimizer_no_split = TensorParallelMuon(
+        params=[model.weight],
+        lr=0.01,
+        split_qkv=False,
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    loss = model(input_tensor).sum()
+    loss.backward()
+    optimizer_no_split.step()
+    weight_no_split = model.weight.data.clone()
+
+    assert not torch.equal(
+        weight_4way, weight_no_split
+    ), "4-way split must produce a different update than no-split — proves the split path ran"
+
+
+def test_muon_optimizer_qgkv_per_block_independence():
+    """Oracle test: 4-way split path must produce exactly the same result as
+    manually splitting [Q | Gate | K | V] and applying scaled NS to each block
+    independently. This is the strict correctness check that each sub-projection
+    truly gets its own Newton-Schulz iteration with no cross-block contamination.
+    """
+    torch.manual_seed(0)
+    ng = 2  # num_query_groups
+    qp = 64
+    kvp = 32
+    hidden = 256
+    shapes = (qp, qp, kvp, kvp)
+    per_group = sum(shapes)  # 192
+    qgkv_size = ng * per_group  # 384
+
+    # Build a deterministic 2D weight with attached metadata.
+    weight = torch.randn(qgkv_size, hidden, dtype=torch.float32, device='cuda')
+    weight.requires_grad_(True)
+    weight.is_qkv = True
+    weight.qkv_split_shapes = list(shapes)
+
+    grad = torch.randn(qgkv_size, hidden, dtype=torch.float32, device='cuda')
+
+    optimizer = TensorParallelMuon(
+        params=[weight],
+        lr=0.01,
+        split_qkv=True,
+        is_qkv_fn=lambda p: getattr(p, 'is_qkv', False),
+        qkv_split_shapes=shapes,
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    # (1) Result from the optimizer's 4-way split path.
+    optimizer_update = optimizer.orthogonalize(weight, grad.clone())
+
+    # (2) Oracle: manually split [Q | Gate | K | V] and run the SAME scaled NS function
+    #     (closure stored on the optimizer) on each sub-block independently, then concat.
+    grad_view = grad.view(ng, per_group, -1)
+    sub_grads = [g.reshape(-1, hidden) for g in torch.split(grad_view, list(shapes), dim=1)]
+    oracle_blocks = [
+        optimizer.scaled_orthogonalize_fn(sg, None, None).view(ng, -1, hidden)
+        for sg in sub_grads
+    ]
+    oracle_update = torch.cat(oracle_blocks, dim=1).view(qgkv_size, hidden)
+
+    # The two MUST match — proves Q, Gate, K, V each got their own NS iteration.
+    assert torch.allclose(optimizer_update, oracle_update, atol=1e-5, rtol=1e-5), (
+        "4-way split path output must equal manual per-block scaled NS — "
+        "this proves Q, Gate, K, V are each NS-iterated independently."
+    )
+
+    # Sanity guard: optimizer output must NOT match whole-block NS, otherwise the
+    # split path silently regressed to no-split.
+    whole_update = optimizer.scaled_orthogonalize_fn(grad.clone(), None, None)
+    assert not torch.allclose(optimizer_update, whole_update, atol=1e-4), (
+        "4-way split output must differ from whole-block NS — "
+        "guard against silent regression to no-split."
+    )
+
+
