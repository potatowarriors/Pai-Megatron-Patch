+"""Unit tests for StepBatchSizeScheduleCalculator and parser."""
+
+import pytest
+
+import megatron.core.num_microbatches_calculator as mb_calc
+
+
+def _reset():
+    mb_calc._GLOBAL_NUM_MICROBATCHES_CALCULATOR = None
+
+
+def test_parse_basic():
+    pairs = mb_calc.parse_step_batch_size_schedule("0:768 250B:1536 500B:3072", seq_length=2048)
+    assert pairs[0] == (0, 768)
+    assert pairs[1] == (250 * 10**9 // 2048, 1536)
+    assert pairs[2] == (500 * 10**9 // 2048, 3072)
+
+
+def test_parse_samples_unit():
+    pairs = mb_calc.parse_step_batch_size_schedule("0:8 1K:16 2K:32", seq_length=None)
+    assert pairs == [(0, 8), (1000, 16), (2000, 32)]
+
+
+def test_parse_unsorted_input_gets_sorted():
+    pairs = mb_calc.parse_step_batch_size_schedule("500:32 0:8 100:16", seq_length=None)
+    assert pairs == [(0, 8), (100, 16), (500, 32)]
+
+
+def test_parse_rejects_missing_zero_threshold():
+    with pytest.raises(ValueError, match="first threshold"):
+        mb_calc.parse_step_batch_size_schedule("100:8 200:16", seq_length=None)
+
+
+def test_parse_rejects_invalid_entry():
+    with pytest.raises(ValueError):
+        mb_calc.parse_step_batch_size_schedule("0:8 500-16", seq_length=None)
+
+
+def test_step_calculator_lookup():
+    _reset()
+    schedule = [(0, 8), (100, 16), (500, 32)]
+    mb_calc.init_num_microbatches_calculator(
+        rank=0,
+        rampup_batch_size=None,
+        global_batch_size=32,  # ignored when step schedule given
+        micro_batch_size=4,
+        data_parallel_size=2,
+        decrease_batch_size_if_needed=False,
+        step_batch_size_schedule=schedule,
+    )
+    assert mb_calc.get_current_global_batch_size() == 8
+
+    mb_calc.update_num_microbatches(50, consistency_check=False)
+    assert mb_calc.get_current_global_batch_size() == 8
+
+    mb_calc.update_num_microbatches(100, consistency_check=False)
+    assert mb_calc.get_current_global_batch_size() == 16
+
+    mb_calc.update_num_microbatches(499, consistency_check=False)
+    assert mb_calc.get_current_global_batch_size() == 16
+
+    mb_calc.update_num_microbatches(500, consistency_check=False)
+    assert mb_calc.get_current_global_batch_size() == 32
+
+    mb_calc.update_num_microbatches(10**9, consistency_check=False)
+    assert mb_calc.get_current_global_batch_size() == 32
+
+
+def test_num_microbatches_correctness():
+    _reset()
+    # GBS=24 at start, MBS=4, DP=2 -> num_microbatches = 24/(4*2) = 3
+    schedule = [(0, 24), (1000, 48)]
+    mb_calc.init_num_microbatches_calculator(
+        rank=0,
+        rampup_batch_size=None,
+        global_batch_size=48,
+        micro_batch_size=4,
+        data_parallel_size=2,
+        decrease_batch_size_if_needed=False,
+        step_batch_size_schedule=schedule,
+    )
+    assert mb_calc.get_num_microbatches() == 3
+    mb_calc.update_num_microbatches(1000, consistency_check=False)
+    assert mb_calc.get_num_microbatches() == 6
+
+
+def test_step_and_rampup_mutually_exclusive():
+    _reset()
+    with pytest.raises(AssertionError, match="cannot specify both"):
+        mb_calc.init_num_microbatches_calculator(
+            rank=0,
+            rampup_batch_size=[8, 8, 1000],
+            global_batch_size=32,
+            micro_batch_size=4,
+            data_parallel_size=2,
+            decrease_batch_size_if_needed=False,
+            step_batch_size_schedule=[(0, 8), (500, 32)],
+        )
