+def test_muon_optimizer_qgkv_per_block_independence():
+    """Oracle test: 4-way split path must produce exactly the same result as
+    manually splitting [Q | Gate | K | V] and applying scaled NS to each block
+    independently. This is the strict correctness check that each sub-projection
+    truly gets its own Newton-Schulz iteration with no cross-block contamination.
+    """
+    torch.manual_seed(0)
+    ng = 2  # num_query_groups
+    qp = 64
+    kvp = 32
+    hidden = 256
+    shapes = (qp, qp, kvp, kvp)
+    per_group = sum(shapes)  # 192
+    qgkv_size = ng * per_group  # 384
+
+    # Build a deterministic 2D weight with attached metadata.
+    weight = torch.randn(qgkv_size, hidden, dtype=torch.float32, device='cuda')
+    weight.requires_grad_(True)
+    weight.is_qkv = True
+    weight.qkv_split_shapes = list(shapes)
+
+    grad = torch.randn(qgkv_size, hidden, dtype=torch.float32, device='cuda')
+
+    optimizer = TensorParallelMuon(
+        params=[weight],
+        lr=0.01,
+        split_qkv=True,
+        is_qkv_fn=lambda p: getattr(p, 'is_qkv', False),
+        qkv_split_shapes=shapes,
+        num_ns_steps=5,
+        pg_collection=None,
+        mode="duplicated",
+    )
+
+    # (1) Result from the optimizer's 4-way split path.
+    optimizer_update = optimizer.orthogonalize(weight, grad.clone())
+
+    # (2) Oracle: manually split [Q | Gate | K | V] and run the SAME scaled NS function
+    #     (closure stored on the optimizer) on each sub-block independently, then concat.
+    grad_view = grad.view(ng, per_group, -1)
+    sub_grads = [g.reshape(-1, hidden) for g in torch.split(grad_view, list(shapes), dim=1)]
+    oracle_blocks = [
+        optimizer.scaled_orthogonalize_fn(sg, None, None).view(ng, -1, hidden)
+        for sg in sub_grads
+    ]
+    oracle_update = torch.cat(oracle_blocks, dim=1).view(qgkv_size, hidden)
+
+    # The two MUST match — proves Q, Gate, K, V each got their own NS iteration.
+    assert torch.allclose(optimizer_update, oracle_update, atol=1e-5, rtol=1e-5), (
+        "4-way split path output must equal manual per-block scaled NS — "
+        "this proves Q, Gate, K, V are each NS-iterated independently."
+    )
+
+    # Sanity guard: optimizer output must NOT match whole-block NS, otherwise the
+    # split path silently regressed to no-split.
+    whole_update = optimizer.scaled_orthogonalize_fn(grad.clone(), None, None)
+    assert not torch.allclose(optimizer_update, whole_update, atol=1e-4), (
+        "4-way split output must differ from whole-block NS — "
+        "guard against silent regression to no-split."
+    )
+
+
