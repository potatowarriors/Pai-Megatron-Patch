+class StepBatchSizeScheduleCalculator(NumMicroBatchesCalculator):
+    """Calculator of number of microbatches with step-wise GBS schedule.
+
+    The schedule is a sorted list of ``(sample_threshold, global_batch_size)`` pairs.
+    At any ``consumed_samples``, the active GBS is the value of the largest threshold that is
+    <= ``consumed_samples``. The first entry must have threshold 0.
+
+    Args:
+        schedule (List[Tuple[int, int]]):
+            Sorted list of ``(sample_threshold, gbs)``. First threshold must be 0.
+        micro_batch_size (int): Micro batch size.
+        data_parallel_size (int): Data parallel size.
+        decrease_batch_size_if_needed (bool):
+            If true, decrease batch size to ensure divisibility by DP size * microbatch size.
+        rank (int): Rank (to determine whether logging should be performed).
+    """
+
+    def __init__(
+        self,
+        schedule: List[Tuple[int, int]],
+        micro_batch_size: int,
+        data_parallel_size: int,
+        decrease_batch_size_if_needed: bool,
+        rank: int,
+    ) -> None:
+        assert len(schedule) >= 1, 'schedule must have at least one entry'
+        self.schedule: List[Tuple[int, int]] = sorted(schedule, key=lambda p: p[0])
+        assert self.schedule[0][0] == 0, (
+            f'first threshold in schedule must be 0, got {self.schedule[0][0]}'
+        )
+        for thr, bs in self.schedule:
+            assert thr >= 0 and bs > 0, f'invalid schedule entry ({thr}, {bs})'
+
+        self.micro_batch_size = micro_batch_size
+        self.data_parallel_size = data_parallel_size
+        self.decrease_batch_size_if_needed = decrease_batch_size_if_needed
+        self.rank = rank
+        self.micro_batch_times_data_parallel_size = micro_batch_size * data_parallel_size
+        assert self.micro_batch_times_data_parallel_size > 0
+        self.global_batch_size = max(p[1] for p in self.schedule)
+        self.current_global_batch_size = None
+        self.current_running_global_batch_size = None
+
+        self.update(0, consistency_check=False, verbose=True)
+
+    def _lookup(self, consumed_samples: int) -> int:
+        active = self.schedule[0][1]
+        for thr, bs in self.schedule:
+            if consumed_samples >= thr:
+                active = bs
+            else:
+                break
+        return active
+
+    def update(self, consumed_samples: int, consistency_check: bool, verbose: bool = False) -> None:
+        """Update number of microbatches based on the step-wise schedule."""
+        old = self.current_global_batch_size
+        new_gbs = self._lookup(consumed_samples)
+        self.current_global_batch_size = new_gbs
+
+        changed = old != new_gbs
+        if self.rank == 0 and changed and verbose:
+            if old is None:
+                logger.info(f'setting initial batch size to {new_gbs}')
+            else:
+                logger.info(
+                    f'step-wise schedule: GBS {old} -> {new_gbs} '
+                    f'(consumed_samples={consumed_samples})'
+                )
+
+        if consistency_check and not self.decrease_batch_size_if_needed:
+            assert (
+                self.current_global_batch_size % self.micro_batch_times_data_parallel_size == 0
+            ), (
+                f'current global batch size ({self.current_global_batch_size}) is not '
+                f'divisible by micro_batch_size ({self.micro_batch_size}) * '
+                f'data_parallel_size ({self.data_parallel_size})'
+            )
+
+        if (
+            self.decrease_batch_size_if_needed
+            and self.current_global_batch_size % self.micro_batch_times_data_parallel_size != 0
+        ):
+            self.current_running_global_batch_size = _round(
+                self.current_global_batch_size, self.micro_batch_times_data_parallel_size
+            )
+            assert (
+                self.current_running_global_batch_size % self.micro_batch_times_data_parallel_size
+                == 0
+            )
+        else:
+            self.current_running_global_batch_size = self.current_global_batch_size
+
+        self.num_micro_batches = (
+            self.current_running_global_batch_size // self.micro_batch_times_data_parallel_size
+        )
